{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@tokens": ["../src/tokens"],
      "@rn": ["../src/rn"],
      "@glyphs": ["../src/icons/geometry"],
      "@metrics": ["../src/metrics"],
      "@app": ["../src/app"],
      "@assets/*": ["../src/assets/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
